generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?

  repescagemEmpreendimentos RepescagemEmpreendimento[]
  oppSemanas               OppSemana[]
  oppItems                  OppItem[]
  lostGrupos                LostGrupo[]
  lostDisparos              LostDisparo[]
  lostHistoricos            LostHistorico[]
  briefings                 Briefing[]
  metas                      Meta[]
  artefatos                  ArtefatoConfig[]
  campanhas                  Campanha[]
}

model RepescagemEmpreendimento {
  id                    String   @id @default(cuid())
  nomeEmpreendimento    String
  textoConteudo         String?
  linkImagem            String?
  dataUltimaAtualizacao DateTime?
  atualizadoPor         String?
  criadoPorId           String?
  criadoPor             User?    @relation(fields: [criadoPorId], references: [id])
  criadoEm              DateTime @default(now())
  atualizadoEm          DateTime @updatedAt
  editadoManualmente    Boolean  @default(false)
  numeros               RepescagemNumero[]
}

model RepescagemNumero {
  id               String   @id @default(cuid())
  campoNome        String
  valorAtual       String?
  dataChecksum     DateTime?
  sinalizador      String?
  verificado       Boolean  @default(false)
  dataVerificado   DateTime?
  empreendimentoId String
  empreendimento   RepescagemEmpreendimento @relation(fields: [empreendimentoId], references: [id], onDelete: Cascade)
  criadoEm        DateTime @default(now())
}

model OppSemana {
  id          String     @id @default(cuid())
  weekStart   DateTime   @unique
  metaSemana  Float?
  observacoes String?
  criadoPorId String?
  criadoPor  User?      @relation(fields: [criadoPorId], references: [id])
  criadoEm    DateTime   @default(now())
  items       OppItem[]
}

model OppItem {
  id                 String    @id @default(cuid())
  nomeEmpreendimento String
  cota               String? // já existe no banco (branch feat/opps-historico-empreendimentos)
  localizacao        String?
  preco              String?
  condicoes          String?
  destaque           Boolean   @default(false)
  tipoDestaque       String?
  justificativa      String?
  textoWhatsapp      String?
  textoEmail         String?
  observacoes        String?
  Disparado          Boolean   @default(false)
  dataDisparo        DateTime?
  comentarioDisparo  String?
  semanaId           String
  semana             OppSemana @relation(fields: [semanaId], references: [id], onDelete: Cascade)
  criadoPorId        String?
  criadoPor          User?     @relation(fields: [criadoPorId], references: [id])
  criadoEm           DateTime  @default(now())
  atualizadoEm       DateTime  @updatedAt
}

model LostGrupo {
  id         String        @id @default(cuid())
  nomeMotivo String
  Disparos   LostDisparo[]
  criadoPorId String?
  criadoPor  User?         @relation(fields: [criadoPorId], references: [id])
  criadoEm   DateTime      @default(now())
  atualizadoEm DateTime   @updatedAt
}

model LostDisparo {
  id                    String         @id @default(cuid())
  dataDisparo           DateTime?
  dataRangeInicio       DateTime?
  dataRangeFim          DateTime?
  etapaFiltro           String?
  textoEmail            String?
  textoWhatsapp         String?
  statusDisparo         String         @default("rascunho")
  comentarioNaoDisparo  String?
  Disparado             Boolean        @default(false)
  comentarioDisparo    String?
  grupoId               String
  grupo                 LostGrupo      @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  criadoPorId           String?
  criadoPor             User?          @relation(fields: [criadoPorId], references: [id])
  criadoEm              DateTime       @default(now())
  atualizadoEm          DateTime       @updatedAt
  historico             LostHistorico[]
}

model LostHistorico {
  id         String       @id @default(cuid())
  tipoEvento String
  comentario String?
  dataEvento DateTime     @default(now())
  disparoId  String
  disparo    LostDisparo  @relation(fields: [disparoId], references: [id], onDelete: Cascade)
  criadoPorId String?
  criadoPor  User?        @relation(fields: [criadoPorId], references: [id])
}

model Briefing {
  id             String    @id @default(cuid())
  titulo          String
  empresa         String?
  canal           String?
  formularioJson  Json?
  status          String    @default("rascunho")
  codigoProtecao  String?
  criadoPorId     String
  criadoPor       User      @relation(fields: [criadoPorId], references: [id])
  criadoEm        DateTime  @default(now())
  atualizadoEm   DateTime  @updatedAt
  dataPublicacao  DateTime?
}

model Meta {
  id                 String   @id @default(cuid())
  trimestre          String
  metaNome            String
  tipo               String
  valorMeta          Float
  valorAtual         Float    @default(0)
  metricasPeriodicas Json?
  criadoPorId        String
  criadoPor          User     @relation(fields: [criadoPorId], references: [id])
  criadoEm           DateTime @default(now())
  atualizadoEm      DateTime @updatedAt
}

model ArtefatoConfig {
  id                String   @id @default(cuid())
  tipo              String
  titulo            String
  descricao         String?
  descricaoDados    String?
  configuracaoJson  Json?
  criadoPorId       String
  criadoPor         User     @relation(fields: [criadoPorId], references: [id])
  criadoEm          DateTime @default(now())
  atualizadoEm     DateTime @updatedAt
}

model LostBoard {
  id         String   @id @default(cuid())
  boardData  Json     // groups, cards, sections, abordagens
  criadoEm   DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

model Campanha {
  id         String   @id @default(cuid())
  nome       String
  contexto   String?
  links      Json     // [{titulo: string, url: string}]
  ordem      Int      @default(0)
  criadoPorId String?
  criadoPor  User?    @relation(fields: [criadoPorId], references: [id])
  criadoEm   DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

// ── Mídia Paga ────────────────────────────────────────────────────────────────

model MidiaPagaMes {
  id               String   @id @default(cuid())
  mes              String   @unique // YYYY-MM, ex: "2026-05"
  estrategia       String?  // Gatilho de teste nos criativos
  campanhasAtivas  String?  // Campanhas já ativas
  briefingsZerados String? // Empreendimentos que precisam de briefing
  criadoEm         DateTime @default(now())
  priorities       MidiaPagaPrioridade[]
}

model Empreendimento {
  id        String   @id @default(cuid())
  nome      String   @unique
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now())
  priorities MidiaPagaPrioridade[]
}

model MidiaPagaPrioridade {
  id               String   @id @default(cuid())
  mesId            String
  mes              MidiaPagaMes @relation(fields: [mesId], references: [id], onDelete: Cascade)
  empreendimentoId String
  empreendimento   Empreendimento @relation(fields: [empreendimentoId], references: [id], onDelete: Cascade)
  criadoEm         DateTime @default(now())
  formatos         MidiaPagaFormato[]
}

model MidiaPagaFormato {
  id             String   @id @default(cuid())
  prioridadeId   String
  prioridade     MidiaPagaPrioridade @relation(fields: [prioridadeId], references: [id], onDelete: Cascade)
  nome           String   // ex: "Estático", "Vídeo Narrado"
  checked        Boolean  @default(false)
  criadoEm       DateTime @default(now())
  estruturas     MidiaPagaEstrutura[]
}

model MidiaPagaEstrutura {
  id        String   @id @default(cuid())
  formatoId String
  formato   MidiaPagaFormato @relation(fields: [formatoId], references: [id], onDelete: Cascade)
  nome      String   // ex: "E1", "E2"
  checked   Boolean  @default(false)
  criadoEm  DateTime @default(now())
  variacoes MidiaPagaVariacao[]
}

model MidiaPagaVariacao {
  id          String   @id @default(cuid())
  estruturaId String
  estrutura   MidiaPagaEstrutura @relation(fields: [estruturaId], references: [id], onDelete: Cascade)
  nome        String   // ex: "V1", "V2"
  checked     Boolean  @default(false)
}

model OppsPassoAPasso {
  id           String   @id @default("singleton")
  conteudoJson Json
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

model OppsCalendarioSemana {
  id           String   @id @default("singleton")
  conteudoJson Json
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

model PlanejamentoFrente {
  id           String              @id @default(cuid())
  nome         String
  cor          String              @default("teal")
  ordem        Int                 @default(0)
  criadoEm     DateTime            @default(now())
  atualizadoEm DateTime            @updatedAt
  acoes        PlanejamentoAcao[]
}

model PlanejamentoAcao {
  id             String             @id @default(cuid())
  frenteId       String
  frente         PlanejamentoFrente @relation(fields: [frenteId], references: [id], onDelete: Cascade)
  mes            String             // "YYYY-MM"
  dia            Int                // 1-31
  titulo         String
  base           String?
  empreendimentos String?
  whatsapp       String?
  email          String?
  rdCampanha     String?
  anotacoes      String?
  links          Json               @default("[]") // [{ label, url }]
  feito          Boolean            @default(false)
  ordem          Int                @default(0)
  slackTs        String?            // ts da thread criada no Slack (entrega_disparos)
  slackEnviadoEm DateTime?
  criadoEm       DateTime           @default(now())
  atualizadoEm   DateTime           @updatedAt

  @@index([mes])
  @@index([frenteId, mes])
}

model AnaliseClaude {
  id          String   @id @default(cuid())
  descricao   String
  links       Json     // [{url: string, label: string}]
  dataAnalise DateTime
  criadoEm   DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

// Tabela alimentada pelo sync da Nekt (pipeline 37 = funil Marketplace, status=lost).
// Grão = deal (um lost por linha, com a data exata da perda). Full-refresh a cada sync.
// Ver docs/sync-losts-marketplace.md.
model MarketplaceLost {
  id            Int      @id @default(autoincrement())
  lostDate      DateTime @map("lost_date") // data da perda (base do filtro)
  motivo        String
  empreendimento String
  etapa         String
  etapaOrdem    Int      @map("etapa_ordem")
  canal         String // Midia Paga | Base Interna | Outros
  syncedAt      DateTime @default(now()) @map("synced_at")

  @@index([lostDate])
  @@map("marketplace_lost")
}

// Análise de disparos da base interna (p37) — agregado por campanha (rd_campanha).
// Base interna = rd_source/rd_campanha contém 'campaign' e nenhum 'pag'. Full-refresh.
// Ver docs/sync-disparos-marketplace.md.
// Criativos de mídia paga (p37 Marketplace). Grão = criativo (rd_campanha sem ID
// da plataforma). Filtro: rd_source contém 'pag' e NÃO contém 'campaign'.
// Contagens CUMULATIVAS: chegar a uma etapa conta em todas as anteriores (won conta em contrato/reunião/sql).
model PaidCreative {
  id         Int      @id @default(autoincrement())
  criativo   String
  plataforma String   @default("Outros") // Meta | Google | Outros
  dataCamp   String?  @map("data_camp")
  leads      Int
  sql        Int // chegou a Contatados+ (ord>=2 ou won)
  reuniao    Int // chegou à Reunião Realizada+ (ord>=8 ou won)
  contrato   Int // chegou a Contrato (ord>=13 ou won)
  won        Int // status won
  syncedAt   DateTime @default(now()) @map("synced_at")

  @@map("paid_creative")
}

model MarketplaceDisparo {
  id       Int      @id @default(autoincrement())
  campanha String
  dataCamp String?  @map("data_camp") // AAAA-MM-DD extraído do nome, quando houver
  leads    Int
  sql      Int // chegou à faixa Contatados→Reunião Agendada (etapa >= 2)
  fup      Int // faixa Reunião Realizada..Reserva (etapa_ordem 8 a 12); Contrato/won não entram aqui
  contrato Int // só na etapa Contrato (etapa_ordem 13) e não won
  won      Int // status won
  syncedAt DateTime @default(now()) @map("synced_at")

  @@map("marketplace_disparo")
}

// ── Criativos que funcionaram no passado ──────────────────────────────────
// Pasta = um empreendimento. Dentro dela, registros de criativos que
// performaram bem, com links/imagem + resultados que trouxeram.
model CriativoPastaEmp {
  id           String              @id @default(cuid())
  nome         String // nome do empreendimento
  ordem        Int                 @default(0)
  criadoEm     DateTime            @default(now())
  atualizadoEm DateTime            @updatedAt
  registros    CriativoRegistro[]

  @@map("criativo_pasta_emp")
}

model CriativoRegistro {
  id             String   @id @default(cuid())
  pastaId        String
  pasta          CriativoPastaEmp @relation(fields: [pastaId], references: [id], onDelete: Cascade)
  titulo         String? // rótulo opcional do criativo
  links          Json     @default("[]") // string[] — links que levam ao criativo
  imagem         String? // imagem do criativo em base64 (data URL)
  idAnuncio      String? // ID do anúncio
  valorInvestido Float? // R$ investido
  mql            Int? // MQLs gerados
  sql            Int? // SQLs gerados
  opp            Int? // Oportunidades geradas
  won            Int? // WONs
  custoPorWon    Float? // custo por WON
  ordem          Int      @default(0)
  criadoEm       DateTime @default(now())
  atualizadoEm   DateTime @updatedAt

  @@map("criativo_registro")
}

// ── Materiais do time comercial (Revendas) ────────────────────────────────
// Lista editável de materiais que o comercial consulta. Cada item aponta
// para um link externo ou para uma rota interna do hub.
model MaterialComercial {
  id           String   @id @default(cuid())
  titulo       String
  descricao    String?
  url          String
  interno      Boolean  @default(false)
  ordem        Int      @default(0)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("material_comercial")
}

// ─────────────────────────────────────────────────────────────────────────────
// Briefings de SPOT (revenda) e os roteiros de mídia paga gerados a partir deles.
//
// ⚠️ NÃO confundir com os models antigos de nome parecido:
//    · `Briefing`      → briefing de CAMPANHA (formulário, proteção por código)
//    · `Empreendimento`→ só nome+ativo, usado pela prioridade de mídia paga
//    · `MidiaPaga*`    → checklist de produção (nome + checked), sem conteúdo
// Por isso tudo aqui leva o prefixo `Spot`.
//
// Hierarquia = a metáfora de pastas:
//    SpotEmpreendimento (37)  →  SpotBriefingRun (uma geração, com data)  →  SpotRoteiro
// ─────────────────────────────────────────────────────────────────────────────

model SpotEmpreendimento {
  id             String   @id @default(cuid())
  spotBuildingId Int?     @unique // id no SZI/Spotsys (Campeche = 17). Null se criado à mão.
  nome           String // "Campeche Spot"
  slug           String   @unique // "campeche-spot"
  cidade         String
  estado         String // abreviado: "SC", "BA" (decidido em 17/09/2026)
  ativo          Boolean  @default(true)
  criadoEm       DateTime @default(now())

  briefings SpotBriefingRun[]

  @@index([nome])
}

model SpotBriefingRun {
  id               String             @id @default(cuid())
  empreendimentoId String
  empreendimento   SpotEmpreendimento @relation(fields: [empreendimentoId], references: [id], onDelete: Cascade)

  geradoEm   DateTime // a data da "pasta" — é o que organiza o histórico
  geradoPor  String? // nome livre; não exige linha em User (quem gera pode ser de outro time)
  origem     String   @default("manual") // manual | skill
  conteudoMd String // o briefing inteiro, markdown, como saiu no terminal

  resumoJson  Json? // ROI, a partir de, ticket médio, nº de cotas, posição na cidade
  avisosJson  Json? // divergências detectadas naquele dia
  artefatoUrl String? // link do artefato — pode estar privado na conta de quem gerou
  docsUrl     String? // link de Google Docs, quando houver
  observacao  String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  roteiros SpotRoteiro[]
  anexos   SpotAnexo[]

  @@index([empreendimentoId, geradoEm])
}

model SpotRoteiro {
  id            String          @id @default(cuid())
  briefingRunId String
  briefingRun   SpotBriefingRun @relation(fields: [briefingRunId], references: [id], onDelete: Cascade)

  codigo     String // R001, R002...
  formato    String // video-narrado | video-apresentadora | estatico
  status     String   @default("teste") // produzido | aprovado | teste
  duracao    String?
  monica     Boolean  @default(false)
  estrutura  String? // a tese da peça
  oQueMuda   String? // o que difere dos outros roteiros da mesma pasta
  derivadoDe String? // código do roteiro que originou este
  conteudoMd String // a tabela de cenas, ou os campos do estático
  criadoEm   DateTime @default(now())

  anexos SpotAnexo[]

  @@index([briefingRunId])
}

model SpotAnexo {
  id            String           @id @default(cuid())
  briefingRunId String?
  briefingRun   SpotBriefingRun? @relation(fields: [briefingRunId], references: [id], onDelete: Cascade)
  roteiroId     String?
  roteiro       SpotRoteiro?     @relation(fields: [roteiroId], references: [id], onDelete: Cascade)

  tipo     String // imagem | link
  titulo   String?
  url      String // link colado (Drive, Docs) ou URL do arquivo enviado
  criadoEm DateTime @default(now())

  @@index([briefingRunId])
  @@index([roteiroId])
}
